# Variables de entorno públicas para Cloudflare Pages (Frontend React / CRACO)
# Configurar en Cloudflare Pages > Settings > Environment Variables.
# NUNCA colocar claves secretas (TURNSTILE_SECRET_KEY o RESEND_API_KEY) en el frontend.

# URL pública del Cloudflare Worker de tickets (sin barra final)
REACT_APP_TICKETS_API_URL=https://api.otxsolutions.com.ar
# Compatibilidad con variable anterior (opcional, usa el mismo valor)
REACT_APP_BACKEND_URL=https://api.otxsolutions.com.ar

# Sitekey PÚBLICA de Cloudflare Turnstile
# En desarrollo local puede usarse la clave de prueba oficial: 1x00000000000000000000AA
REACT_APP_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Opcional: enlace HTTPS de pago de Mercado Pago para Asistencia Remota
REACT_APP_MERCADOPAGO_PAYMENT_LINK=
