# =============================================================================
# Variables locales de desarrollo para Cloudflare Worker (`wrangler dev`)
# Copiar este archivo como `.dev.vars` (ignorado por Git) para pruebas locales.
# =============================================================================

ENVIRONMENT="development"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
TURNSTILE_ALLOWED_HOSTNAMES="localhost,127.0.0.1,example.com"
TURNSTILE_EXPECTED_ACTION="ticket_submit"

# Clave secreta oficial de prueba de Cloudflare Turnstile (siempre aprueba en local; bloqueada en staging/production)
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Sal criptográfica para anonimizar IPs en el rate-limiter (obligatoria >= 16 chars en staging/production)
IP_HASH_SALT="dev-local-salt-otx-solutions-2026"

# Opcional en desarrollo: dejar vacío para omitir el envío de correos (estado SKIPPED_UNCONFIGURED)
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="OTX Solutions <notificaciones@otxsolutions.com.ar>"
NOTIFICATION_TO_EMAIL="solutionsotx@gmail.com"
